# electron-builder + pnpm need a hoisted node_modules layout so that the
# externalized runtime dependency (weaviate-client and its gRPC deps) is
# packaged correctly into the final app.
node-linker=hoisted
shamefully-hoist=true
# Don't fail install because weaviate-client declares engines node>=22;
# Electron ships its own Node 22 runtime, so the app runtime is satisfied.
engine-strict=false
